# SI Self-Hosting Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_USER=si
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=si

# ============================================================================
# SpiceDB Configuration
# ============================================================================
SPICEDB_PRESHARED_KEY=changeme_secure_spicedb_key
ZED_KEYRING_PASSWORD=changeme_secure_zed_password

# ============================================================================
# Authentication Configuration
# ============================================================================
# Local Auth Mode - bypasses Auth0 for self-hosted deployments
# Set to "true" to use local authentication (recommended for self-hosting)
# Set to "false" to use Auth0 (requires Auth0 credentials below)
LOCAL_AUTH_MODE=true

# Auth0 Configuration (only required if LOCAL_AUTH_MODE=false)
# If using Auth0 for production authentication, set LOCAL_AUTH_MODE=false and configure:
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=your_client_id
# AUTH0_CLIENT_SECRET=your_client_secret

# JWT Secret for auth-api
JWT_SECRET=changeme_very_secure_jwt_secret

# Auth API URL (for SDF to connect to)
AUTH_API_URL=http://auth-api:9001

# ============================================================================
# Redis Configuration (for auth-api sessions)
# ============================================================================
REDIS_URL=redis://redis:6379

# ============================================================================
# Logging Configuration
# ============================================================================
# Set to true to output logs in JSON format
SI_LOG_JSON=true

# Rust log level: trace, debug, info, warn, error
RUST_LOG=info

# ============================================================================
# Optional: OpenAI Integration
# ============================================================================
# SI_OPENAI_API_KEY=sk-...
# SI_OPENAI_API_BASE=https://api.openai.com/v1
# SI_OPENAI_ORG_ID=org-...
# SI_OPENAI_PROJECT_ID=proj-...

# ============================================================================
# Build Configuration
# ============================================================================
# Docker registry for local builds
DOCKER_REGISTRY=localhost:5000

# Build mode: release or debug
BUILD_MODE=release

# Number of parallel builds
PARALLEL_BUILDS=4
